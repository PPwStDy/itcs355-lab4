{
  "uid": "lab4",
  "title": "Lab 4 prediction service",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{route=~\"/predict.*\"}[1m]))",
          "legendFormat": "{{feature}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate by class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(http_requests_total{status_class=~\"4xx|5xx\",route=~\"/predict.*\"}[5m])) / scalar(sum(rate(http_requests_total{route=~\"/predict.*\"}[5m])))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(request_latency_ms_bucket{route=~\"/predict.*\"}[5m])))",
          "legendFormat": "0.5"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(request_latency_ms_bucket{route=~\"/predict.*\"}[5m])))",
          "legendFormat": "0.95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(request_latency_ms_bucket{route=~\"/predict.*\"}[5m])))",
          "legendFormat": "0.99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Feature mean (five minute input window)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "feature_mean{feature=\"temp_c\"}",
          "legendFormat": "{{feature}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Feature drift PSI (five minute input window)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "drift_psi{feature=\"temp_c\"}",
          "legendFormat": "{{feature}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Model version in production",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "textMode": "name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "model_version_info",
          "legendFormat": "{{version}}"
        }
      ]
    }
  ]
}
